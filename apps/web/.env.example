# Auth mode: "fake" (dev server with AUTH_MODE=fake) or "supabase".
# Defaults to "supabase" when VITE_SUPABASE_URL is set.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to "1" to expose the design-review screens outside `vite dev` (e.g. preview builds).
VITE_DEV_SCREENS=
# Public address of the game in the shared text ("… · https://pasishte.example/?s=share"); defaults to the page origin.
VITE_PUBLIC_URL=
