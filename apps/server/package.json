{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8787",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist/worker",
    "test": "vitest run",
    "types": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate --name init",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bc/game-core": "workspace:*",
    "@bc/i18n": "workspace:*",
    "@bc/protocol": "workspace:*",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.151.2"
  }
}
