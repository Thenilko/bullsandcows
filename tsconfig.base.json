{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@bc/game-core": ["packages/game-core/src/index.ts"],
      "@bc/i18n": ["packages/i18n/src/index.ts"],
      "@bc/protocol": ["packages/protocol/src/index.ts"]
    }
  }
}
