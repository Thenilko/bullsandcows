{
  "name": "bullsandcows",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,server \"pnpm --filter web dev\" \"pnpm --filter server dev\"",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p packages/game-core/tsconfig.test.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.0",
    "vitest": "2.1.9"
  }
}
